NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001
# Number of trusted reverse proxy hops; keep at 0 for a direct connection.
TRUST_PROXY_HOPS=0
# Persistent image storage; relative paths are resolved from the backend working directory.
UPLOAD_DIR=uploads
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=myrest
DB_USER=myrest
DB_PASSWORD=
# DB_TLS_CA_FILE=/path/to/mysql-ca.pem
