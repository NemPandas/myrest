NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001
# Additional frontend origins allowed to send admin requests (comma-separated).
APP_ORIGINS=http://localhost:5173,http://localhost:5174
# Use 1 behind the supplied Nginx proxy for visitor IP detection; 0 for direct connections.
TRUST_PROXY_HOPS=0
# Persistent image storage; relative paths are resolved from the backend working directory.
UPLOAD_DIR=uploads
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=myrest
DB_USER=myrest
DB_PASSWORD=
# DB_TLS_CA_FILE=/path/to/mysql-ca.pem

# Brevo transactional API (server only; never put this key in a VITE variable).
# Sender must be verified in Brevo. Leave unset to keep email sending disabled; orders still save.
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=orders@your-domain.example
EMAIL_FROM_NAME=MyRest
# ORDER_NOTIFY_EMAIL=owner@your-domain.example
# BANK_BENEFICIARY=Your company
# BANK_ACCOUNT=Your IBAN / account number
# BANK_BIC=Your BIC
# Gross shipping fees default to 0; override with approved fees when needed.
# ORDER_SHIPPING_HUF=0
# ORDER_SHIPPING_EUR=0
