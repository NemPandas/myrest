{
  "name": "@myrest/backend",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "owner:create": "node --env-file-if-exists=.env dist/create-owner.js",
    "sessions:prune": "node --env-file-if-exists=.env dist/prune-sessions.js",
    "test:images": "npm run build && node --test test/images.test.mjs",
    "test:integration": "npm run build && node --env-file-if-exists=.env.test --test test/mysql.test.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "private": true,
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
